# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Local Ollama is the zero-cost default. The disposable Agent Runtime reaches
# Windows/macOS Ollama through Docker Desktop's host.docker.internal address.
MODEL_PROVIDER=ollama
MODEL_API_KEY=ollama
MODEL_ID=qwen3:8b
MODEL_BASE_URL=http://host.docker.internal:11434/v1

# Optional BytePlus ModelArk compatibility. Either use the generic MODEL_*
# variables above with MODEL_PROVIDER=ark, or keep these legacy names.
# ARK_API_KEY=replace-with-your-ark-api-key
# ARK_MODEL=ep-replace-with-your-endpoint-id
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Kafka supervisor. The host-run local POC uses the published port below;
# docker-compose.yml overrides it to kafka:9092 for the launchpad container.
KAFKA_ENABLED=true
KAFKA_BROKERS=127.0.0.1:29092
KAFKA_CLIENT_ID=codejam-supervisor
KAFKA_EVENTS_TOPIC=agent-run-events-v1
KAFKA_COMMANDS_TOPIC=agent-run-commands-v1
KAFKA_EVENT_CONSUMER_GROUP=supervisor-ledger-v1
KAFKA_COMMAND_CONSUMER_GROUP=supervisor-commands-v1
SUPERVISOR_LEDGER_PATH=/app/data/supervisor.sqlite
SUPERVISOR_HEARTBEAT_INTERVAL_MS=2000
SUPERVISOR_STALL_AFTER_MS=8000
SUPERVISOR_WATCHDOG_INTERVAL_MS=1000

# Read-only operator chatbot. It reuses the local Ollama model and may only call
# the six allowlisted ledger tools. The base URL defaults to MODEL_BASE_URL with
# host.docker.internal rewritten to 127.0.0.1, because the control plane talks to
# Ollama directly while the Agent Runtime container goes through Docker's host
# alias. Override it when neither address is correct for your setup.
# SUPERVISOR_CHAT_BASE_URL=http://127.0.0.1:11434/v1
# SUPERVISOR_CHAT_MODEL=qwen3:8b
SUPERVISOR_CHAT_TIMEOUT_MS=90000
SUPERVISOR_CHAT_MAX_TOOL_CALLS=3

# Demo-only controls. When true, the dashboard can pause a Runtime container so
# its heartbeat genuinely stops. Container labels are verified before the pause.
# Keep this false outside a demo.
ENABLE_DEMO_CONTROLS=false

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
